<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <title>天気APIテスト</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <!-- Bootstrap 5 CDN -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <div class="container py-4">
    <h1 class="text-center mb-4">🌤 天気APIテスト</h1>

    <!-- ログイン -->
    <div class="card mb-4">
      <div class="card-header">ログイン</div>
      <div class="card-body">
        <form id="login-form">
          <div class="mb-3">
            <label for="username" class="form-label">ユーザー名</label>
            <input type="text" class="form-control" id="username" value="admin">
          </div>
          <div class="mb-3">
            <label for="password" class="form-label">パスワード</label>
            <input type="password" class="form-control" id="password" value="password">
          </div>
          <button type="submit" class="btn btn-primary w-100">ログイン</button>
        </form>
        <label class="mt-3">取得したJWTトークン</label>
        <textarea id="token" class="form-control" rows="2" readonly></textarea>
      </div>
    </div>

    <!-- パラメータ -->
    <div class="card mb-4">
      <div class="card-header">リクエストパラメータ</div>
      <div class="card-body">
        <div class="mb-3">
          <label for="city" class="form-label">都市名</label>
          <input type="text" class="form-control" id="city" value="Tokyo">
        </div>
        <div class="mb-3 row">
          <div class="col">
            <label for="lat" class="form-label">緯度</label>
            <input type="text" class="form-control" id="lat" value="35.6895">
          </div>
          <div class="col">
            <label for="lon" class="form-label">経度</label>
            <input type="text" class="form-control" id="lon" value="139.6917">
          </div>
        </div>
        <div class="d-grid gap-2">
          <button class="btn btn-secondary" onclick="fetchWeather()">現在の天気</button>
          <button class="btn btn-secondary" onclick="fetchForecast()">天気予報</button>
          <button class="btn btn-secondary" onclick="fetchGeoWeather()">緯度経度の天気</button>
          <button class="btn btn-secondary" onclick="fetchAlert()">雨雲アラート</button>
          <button class="btn btn-secondary" onclick="fetchAir()">大気汚染</button>
        </div>
      </div>
    </div>

    <!-- 結果 -->
    <div class="card">
      <div class="card-header">APIレスポンス</div>
      <div class="card-body">
        <pre id="result" class="bg-white p-2 border rounded" style="white-space: pre-wrap;">ここにAPIの結果が表示されます</pre>
      </div>
    </div>
  </div>

  <script>
    const tokenBox = document.getElementById("token");
    const resultBox = document.getElementById("result");

    document.getElementById("login-form").addEventListener("submit", async (e) => {
      e.preventDefault();
      const username = document.getElementById("username").value;
      const password = document.getElementById("password").value;

      try {
        const res = await fetch("https://192.168.0.11/login", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ username, password })
        });
        const data = await res.json();
        tokenBox.value = data.access_token || "ログインエラー: " + JSON.stringify(data);
      } catch (err) {
        tokenBox.value = "通信エラー: " + err;
      }
    });

    const getToken = () => tokenBox.value.trim();

    const callAPI = async (endpoint) => {
      const token = getToken();
      if (!token) {
        resultBox.textContent = "❗ 先にログインしてください。";
        return;
      }
      try {
        const res = await fetch(`https://192.168.0.11${endpoint}`, {
          method: "GET",
          headers: { "Authorization": `Bearer ${token}` }
        });
        const data = await res.json();
        resultBox.textContent = JSON.stringify(data, null, 2);
      } catch (err) {
        resultBox.textContent = "API呼び出しエラー: " + err;
      }
    };

    const fetchWeather = () => {
      const city = document.getElementById("city").value;
      callAPI(`/api/weather?city=${encodeURIComponent(city)}`);
    };

    const fetchForecast = () => {
      const city = document.getElementById("city").value;
      callAPI(`/api/weather/forecast?city=${encodeURIComponent(city)}`);
    };

    const fetchGeoWeather = () => {
      const lat = document.getElementById("lat").value;
      const lon = document.getElementById("lon").value;
      callAPI(`/api/weather/geo?lat=${lat}&lon=${lon}`);
    };

    const fetchAlert = () => {
      const city = document.getElementById("city").value;
      callAPI(`/api/weather/alert?city=${encodeURIComponent(city)}`);
    };

    const fetchAir = () => {
      const lat = document.getElementById("lat").value;
      const lon = document.getElementById("lon").value;
      callAPI(`/api/weather/air?lat=${lat}&lon=${lon}`);
    };
  </script>
</body>
</html>
